#!/usr/bin/env python3
"""Strip Cursor agent attribution trailers from commit messages."""
import re
import sys
from pathlib import Path

if len(sys.argv) < 2:
    raise SystemExit(0)

path = Path(sys.argv[1])
if not path.is_file():
    raise SystemExit(0)

text = path.read_text(encoding="utf-8")
patterns = [
    r"(?m)^Co-authored-by:\s*Cursor\s*<cursoragent@cursor\.com>\s*\n?",
    r"(?m)^Made-with:\s*Cursor\s*\n?",
    r"(?m)^Made with Cursor\s*\n?",
]
for pat in patterns:
    text = re.sub(pat, "", text)
path.write_text(text.rstrip() + "\n", encoding="utf-8")
